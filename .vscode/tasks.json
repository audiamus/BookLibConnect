{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-booklibconnect-debug",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/Connect.app.gui.core/Connect.app.gui.core.csproj",
        "-c",
        "Debug",
        "-p:Platform=AnyCPU"
      ],
      "group": "build",
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "build-booklibconnect-release",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/Connect.app.gui.core/Connect.app.gui.core.csproj",
        "-c",
        "Release",
        "-p:Platform=AnyCPU"
      ],
      "group": "build",
      "problemMatcher": [
        "$msCompile"
      ]
    }
  ]
}
